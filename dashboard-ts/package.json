{
  "name": "chart-analyst-dashboard-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only TypeScript view of the chart-analyst paper desk. Places no orders.",
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "build": "npm run build -w web",
    "test": "tsx --test server/read.test.ts server/auth.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20" }
}
